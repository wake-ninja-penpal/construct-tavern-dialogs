generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* ── заготовка авторизации «Ветви» ──
   Аккаунты (логин+пароль), сессии (cookie-токен), ссылки-инвайты для
   регистрации (одноразовые или на N регистраций), глобальные настройки
   (вкл/выкл авторизации и регистрации — ключ-значение), доступы к проектам. */

model AuthUser {
  id           String        @id @default(cuid())
  login        String        @unique
  passwordHash String
  displayName  String?
  disabled     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  sessions     AuthSession[]
}

model AuthSession {
  token     String    @id
  userId    String
  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model InviteLink {
  id        String   @id @default(cuid())
  code      String   @unique
  maxUses   Int      @default(1)
  uses      Int      @default(0)
  disabled  Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
}

model AppSetting {
  key   String @id
  value String
}

model ProjectAccess {
  id        String   @id @default(cuid())
  projectId String
  login     String
  role      String   @default("editor")
  createdAt DateTime @default(now())

  @@unique([projectId, login])
}
