// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* ── заготовка авторизации «Ветви» ──
   Аккаунты (логин+пароль), сессии (cookie-токен), ссылки-инвайты для
   регистрации (одноразовые или на N регистраций), глобальные настройки
   (вкл/выкл авторизации и регистрации — ключ-значение), доступы к проектам
   (комната + роль) и уведомления аккаунта. */

model AuthUser {
  id            String         @id @default(cuid())
  login         String         @unique
  passwordHash  String
  displayName   String?
  color         String         @default("#8b929c")
  disabled      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  sessions      AuthSession[]
  notifications Notification[]
}

model AuthSession {
  token     String    @id
  userId    String
  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model InviteLink {
  id        String   @id @default(cuid())
  code      String   @unique
  maxUses   Int      @default(1)
  uses      Int      @default(0)
  disabled  Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
}

model AppSetting {
  key   String @id
  value String
}

model ProjectAccess {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  role        String   @default("editor") // owner | editor | reader
  projectId   String?
  projectName String?
  ownerName   String?
  createdAt   DateTime @default(now())

  @@unique([roomId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
