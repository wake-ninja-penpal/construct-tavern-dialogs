// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* ── заготовка авторизации «Ветви» ──
   Аккаунты (логин+пароль), сессии (cookie-токен), ссылки-инвайты для
   регистрации (одноразовые или на N регистраций), глобальные настройки
   (вкл/выкл авторизации и регистрации — ключ-значение), доступы к проектам
   (комната + роль) и уведомления аккаунта. */

model AuthUser {
  id            String         @id @default(cuid())
  login         String         @unique
  passwordHash  String
  displayName   String?
  color         String         @default("#8b929c")
  disabled      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  sessions      AuthSession[]
  notifications Notification[]
}

model AuthSession {
  token     String    @id
  userId    String
  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model InviteLink {
  id        String   @id @default(cuid())
  code      String   @unique
  maxUses   Int      @default(1)
  uses      Int      @default(0)
  disabled  Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
}

model AppSetting {
  key   String @id
  value String
}

model ProjectAccess {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  role        String   @default("editor") // owner | editor | reader
  projectId   String?
  projectName String?
  ownerName   String?
  createdAt   DateTime @default(now())

  @@unique([roomId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/* ── сервисы хаба: несколько приложений под одной учётной записью ──
   ServiceApp — реестр подключённых сервисов (ключ, имя, адрес, статус,
   вкл/выкл). «Ветви» — первый сервис, остальные подключаются админом.
   ServiceAccess — персональные ограничения: строка с allowed=false
   запрещает пользователю сервис; отсутствие строки — доступ разрешён. */
model ServiceApp {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  icon        String   @default("grid")
  path        String   @default("")
  status      String   @default("placeholder")
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model ServiceAccess {
  id         String   @id @default(cuid())
  serviceKey String
  userId     String
  allowed    Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@unique([serviceKey, userId])
}

/* ── менеджер задач (сервис task-manager) ──
   Командное kanban-пространство хаба: проекты → доски → колонки → задачи.
   Общая для всех пользователей сервиса (единая команда), автор записывается
   в задачи для истории. Связи с нодами «Ветвей» — JSON-массив links в задаче:
   [{ pid (roomId || projectId слота), nid (id ноды), room (roomId|null),
      t (название ноды на момент связывания) }] — по ним рисуются чипы
   в менеджере задач и иконки прогресса над нодами в «Ветвях». */
model TaskProject {
  id        String   @id @default(cuid())
  title     String
  color     String   @default("#e2a54e")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  boards    TaskBoard[]
}

model TaskBoard {
  id        String      @id @default(cuid())
  projectId String
  project   TaskProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  columns   TaskColumn[]
}

model TaskColumn {
  id        String    @id @default(cuid())
  boardId   String
  board     TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String
  color     String    @default("#8b929c")
  kind      String    @default("") // new | progress | done | "" — семантическая колонка
  locked    Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
}

model TaskItem {
  id          String    @id @default(cuid())
  projectId   String
  boardId     String?
  columnId    String? // null — задача в бэклоге проекта
  parentId    String?
  title       String
  description String    @default("")
  stickers    String    @default("{}") // JSON {assignees:[login], deadline, priority}
  links       String    @default("[]") // JSON — связи с нодами «Ветвей»
  done        Boolean   @default(false)
  completedAt DateTime?
  order       Float     @default(0) // дробный порядок — перестановка без перенумерации
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
