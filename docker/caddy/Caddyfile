# ─────────────────────────────────────────────────────────────────────────────
# «Ветви» — шлюз контейнерной сборки (повторяет Caddy-шлюз песочницы).
#
#   ?XTransformPort=3003  →  realtime-сервер socket.io (контейнер sync)
#   всё остальное         →  Next.js (контейнер web)
#
# При добавлении новых мини-сервисов скопируйте блок handle и добавьте
# соответствие порта имени контейнера.
# ─────────────────────────────────────────────────────────────────────────────

:80 {
	@vetvi_sync query XTransformPort=3003

	handle @vetvi_sync {
		reverse_proxy sync:3003
	}

	handle {
		reverse_proxy web:3000
	}
}
